# ==============================================================================
# BK EDU by Minaaz — Vercel Environment Variables
# Add these in Vercel Project Settings -> Environment Variables
# ==============================================================================

# --- GOOGLE SHEETS / GOOGLE APPS SCRIPT CONFIGURATION ---
# Web App URL generated after deploying your Google Apps Script
# Example: https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec"

# Shared secret string used to authenticate server-side requests to Google Apps Script
GOOGLE_SHEETS_INGEST_SECRET="YourServerSideIngestSecret123!"

# --- RAZORPAY CONFIGURATION ---
# Found in Razorpay Dashboard -> Settings -> API Keys (use Test Mode keys first for testing)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"

# Razorpay Webhook Secret (set in Razorpay Dashboard -> Settings -> Webhooks)
# Webhook URL: https://your-domain.vercel.app/api/webhook
# Active Events to select: order.paid, payment.captured, payment.failed, refund.created, refund.processed
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# --- ADMIN DASHBOARD AUTHENTICATION ---
# Password used to log in to /admin dashboard
ADMIN_PASSWORD="ChooseAStrongAdminPassword123!"

# Secret key used to sign Admin session tokens (use any long random string)
ADMIN_JWT_SECRET="bk_edu_mumbai_admin_jwt_secret_change_me_random_string_2026"
