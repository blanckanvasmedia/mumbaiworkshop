# ==============================================================================
# BK EDU by Minaaz — Mumbai Mega Workshop
# Environment Variables Configuration (GoDaddy Node.js Hosting & Local Development)
#
# On GoDaddy:
# 1. You can create a file named .env in your application root directory, OR
# 2. Add these variables in cPanel -> Setup Node.js App -> Environment variables
# ==============================================================================

# Server Port (GoDaddy assigns PORT automatically; defaults to 3000 locally)
PORT=3000
NODE_ENV=production

# --- GOOGLE SHEETS / GOOGLE APPS SCRIPT CONFIGURATION ---
# Web App URL generated after deploying your Google Apps Script
# Example: https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec"

# Shared secret string used to authenticate server-side requests to Google Apps Script
GOOGLE_SHEETS_INGEST_SECRET="YourServerSideIngestSecret123!"

# --- RAZORPAY CONFIGURATION ---
# Found in Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_live_TWMBEqIOCmE68X"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"

# Razorpay Webhook Secret (set in Razorpay Dashboard -> Settings -> Webhooks)
# Webhook URL: https://your-domain.com/api/webhook
# Active Events: order.paid, payment.captured, payment.failed, refund.created, refund.processed
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# Fallback payment link if Razorpay API keys are not present
RAZORPAY_FALLBACK_URL="https://rzp.io/rzp/NrwSNBZG"

# Workshop Registration Fee in INR (e.g. 999 or 1500)
WORKSHOP_FEE_INR=999

# --- GOOGLE ANALYTICS 4 (OPTIONAL) ---
# Measurement ID from GA4 Admin -> Data Streams (Format: G-XXXXXXXXXX)
# When set, GA4 automatically activates without needing Vercel Analytics
GA_MEASUREMENT_ID=""

# --- ADMIN DASHBOARD AUTHENTICATION ---
# Password used to log in to /admin dashboard
ADMIN_PASSWORD="ChooseAStrongAdminPassword123!"

# Secret key used to sign Admin session tokens (any long random string)
ADMIN_JWT_SECRET="bk_edu_mumbai_admin_jwt_secret_change_me_random_string_2026"
